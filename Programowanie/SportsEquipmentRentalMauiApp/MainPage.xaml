<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="SportsEquipmentRentalMauiApp.MainPage"
             x:Name="thisPage"
             BindingContext="{x:Reference thisPage}">

    <ScrollView>
        <StackLayout Spacing="12" Background="White" Padding="20">
            <Label Text="Wypożyczalnia sprzętu sportowego" 
                   FontSize="22" 
                   HorizontalOptions="Center"/>

            <StackLayout Orientation="Horizontal" Spacing="12">
                <Label Text="Imię i nazwisko" VerticalOptions="Center"/>
                <Entry Text="{Binding ClientName}"
                       Placeholder="Imię i nazwisko"/>
            </StackLayout>

            <StackLayout Spacing="6">
                <Label Text="Wybierz sprzęt:" />
                <CollectionView HeightRequest="120"
                                ItemsSource="{Binding EquipmentList}"
                                SelectedItem="{Binding SelectedEquipment}"
                                SelectionMode="Single">
                    <CollectionView.ItemTemplate>
                        <DataTemplate>
                            <StackLayout Orientation="Horizontal" Padding="5">
                                <Label Text="{Binding Name}" VerticalOptions="Center"/>
                                <Label Text=" - " VerticalOptions="Center"/>
                                <Label Text="{Binding PricePerDay, StringFormat='{0} zł/dzień'}" VerticalOptions="Center"/>
                            </StackLayout>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
            </StackLayout>

            <StackLayout Orientation="Horizontal" Spacing="12">
                <Label Text="Liczba dni" VerticalOptions="Center"/>
                <Stepper Increment="1"
                         Minimum="1"
                         Maximum="7"
                         Value="{Binding NumberOfDays}"/>
                <Label Text="{Binding NumberOfDays}"
                       VerticalOptions="Center"/>
            </StackLayout>

            <StackLayout Orientation="Horizontal" Spacing="12">
                <Label Text="Ubezpieczenie:" VerticalOptions="Center"/>
                <CheckBox IsChecked="{Binding HasInsurance}"/>
                <Label Text="{Binding HasInsurance}" VerticalOptions="Center"/>
            </StackLayout>

            <Button Clicked="Button_Clicked"
                    Text="Oblicz koszt"/>

            <Label Text="Podsumowanie:"/>
            <Label Text="{Binding ResultMessage}"/>

        </StackLayout>
    </ScrollView>

</ContentPage>
