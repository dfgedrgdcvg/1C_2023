<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="VocabularyFlashcardsMauiApp.MainPage"
             x:Name="thisPage"
             BindingContext="{x:Reference thisPage}">

    <ScrollView>
        <StackLayout Spacing="15" Background="White" Padding="20">
            <Label Text="Fiszki do nauki słówek" 
                   FontSize="22" 
                   HorizontalOptions="Center"/>

            <CarouselView x:Name="cardsCarousel"
                          HeightRequest="150"
                          ItemsSource="{Binding Flashcards}"
                          CurrentItem="{Binding SelectedFlashcard}"
                          IndicatorView="indicatorView">
                <CarouselView.ItemTemplate>
                    <DataTemplate>
                        <Frame BackgroundColor="#f0f0f0" 
                               HasShadow="True" 
                               CornerRadius="10" 
                               HorizontalOptions="Center" 
                               VerticalOptions="Center" 
                               WidthRequest="250" 
                               HeightRequest="120">
                            <StackLayout VerticalOptions="Center" HorizontalOptions="Center">
                                <Label Text="{Binding English}" 
                                       FontSize="28" 
                                       FontAttributes="Bold" 
                                       HorizontalOptions="Center"/>
                            </StackLayout>
                        </Frame>
                    </DataTemplate>
                </CarouselView.ItemTemplate>
            </CarouselView>

            <IndicatorView x:Name="indicatorView"
                           HorizontalOptions="Center"
                           IndicatorColor="LightGray"
                           SelectedIndicatorColor="DarkGray" />

            <Button Clicked="ShowTranslation_Clicked"
                    Text="Pokaż tłumaczenie"/>

            <Label Text="Tłumaczenie:" />
            <Label Text="{Binding TranslationText}" 
                   FontSize="20" 
                   FontAttributes="Bold"/>

            <Button Clicked="Restart_Clicked"
                    Text="Zacznij od początku"/>

        </StackLayout>
    </ScrollView>

</ContentPage>
